@model AgizDisSagligi.Web.Models.ProfilViewModel
@{
    ViewData["Title"] = "Profil";
}

<div class="sayfa-baslik">
    <span class="simge">👤</span>
    <h1 class="h3 mb-0">Profil</h1>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success">@TempData["Mesaj"]</div>
}

<div class="seri-kutusu mb-4">
    <div class="seri-simge">🔥</div>
    <div>
        <div class="seri-deger">@Model.GunlukSeri gün</div>
        <div class="seri-etiket">
            @if (Model.GunlukSeri > 0)
            {
                <text>Günlük serin devam ediyor — böyle gitsin!</text>
            }
            else
            {
                <text>Henüz bir serin yok — bugün bir hedefini tamamlayarak başla.</text>
            }
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="istatistik-kart">
            <div class="istatistik-simge">🎯</div>
            <div>
                <div class="istatistik-deger">@Model.ToplamHedefSayisi</div>
                <div class="istatistik-etiket">Toplam Hedef</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="istatistik-kart">
            <div class="istatistik-simge">✅</div>
            <div>
                <div class="istatistik-deger">@Model.ToplamTamamlananSayisi</div>
                <div class="istatistik-etiket">Tamamlanan Kayıt</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="istatistik-kart">
            <div class="istatistik-simge">📝</div>
            <div>
                <div class="istatistik-deger">@Model.ToplamNotSayisi</div>
                <div class="istatistik-etiket">Eklenen Not</div>
            </div>
        </div>
    </div>
</div>

<div class="kart mb-4" style="max-width: 560px;">
    <div class="kart-govde">
        <h2 class="h5 mb-3">Bilgilerimi Güncelle</h2>
        <form asp-controller="Profil" asp-action="Guncelle" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" />
                <span asp-validation-for="AdSoyad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Mail</label>
                <input asp-for="Mail" type="email" class="form-control" />
                <span asp-validation-for="Mail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Doğum Tarihi</label>
                <input asp-for="DogumTarihi" type="date" class="form-control" />
                <span asp-validation-for="DogumTarihi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni Parola <span class="form-text">(değiştirmek istemiyorsanız boş bırakın)</span></label>
                <input asp-for="YeniParola" type="password" class="form-control" />
                <span asp-validation-for="YeniParola" class="text-danger"></span>
                <div class="form-text">Büyük-küçük harf ve rakam içermelidir.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni Parola Tekrar</label>
                <input asp-for="YeniParolaTekrar" type="password" class="form-control" />
                <span asp-validation-for="YeniParolaTekrar" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Mevcut Parola <span class="form-text">(parola değiştirmek için zorunlu)</span></label>
                <input asp-for="MevcutParola" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="MevcutParola" class="text-danger"></span>
            </div>

            <div class="text-muted small mb-3">Kayıt tarihi: @Model.KayitTarihi.ToString("dd.MM.yyyy")</div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
        </form>
    </div>
</div>

<h2 class="h5 mb-3">Rozetler</h2>
<div class="rozet-listesi">
    @foreach (var rozet in Model.Rozetler)
    {
        <div class="rozet-karti @(rozet.Kazanildi ? "kazanildi" : "kilitli")">
            <div class="rozet-simge">@rozet.Simge</div>
            <div class="rozet-ad">@rozet.Ad</div>
            <div class="rozet-aciklama">@rozet.Aciklama</div>
        </div>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
