@model AgizDisSagligi.Web.Models.GirisViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<h1>Giriş Yap</h1>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success">@TempData["Mesaj"]</div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Giris" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Mail</label>
                <input asp-for="Mail" type="email" class="form-control" />
                <span asp-validation-for="Mail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Parola</label>
                <input asp-for="Parola" type="password" class="form-control" />
                <span asp-validation-for="Parola" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Giriş Yap</button>
            <a asp-action="ParolaHatirlat" class="btn btn-link">Parolamı unuttum</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
