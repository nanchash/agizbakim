@model AgizDisSagligi.Web.Models.KayitViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="auth-sarmalayici">
    <div class="auth-kart">
        <div class="auth-simge">🦷</div>
        <h1>Hesap Oluştur</h1>
        <p class="auth-alt-metin">Ağız ve diş sağlığı yolculuğunuza bugün başlayın.</p>

        <form asp-action="Kayit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Mail</label>
                <input asp-for="Mail" type="email" class="form-control" placeholder="ornek@mail.com" />
                <span asp-validation-for="Mail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Parola</label>
                <input asp-for="Parola" type="password" class="form-control" placeholder="En az 8 karakter" />
                <span asp-validation-for="Parola" class="text-danger"></span>
                <div class="form-text">Büyük-küçük harf ve rakam içermelidir.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Parola Tekrar</label>
                <input asp-for="ParolaTekrar" type="password" class="form-control" />
                <span asp-validation-for="ParolaTekrar" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" placeholder="Adınız Soyadınız" />
                <span asp-validation-for="AdSoyad" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Doğum Tarihi</label>
                <input asp-for="DogumTarihi" type="date" class="form-control" />
                <span asp-validation-for="DogumTarihi" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
        </form>

        <p class="auth-alt-metin mt-3 mb-0">
            Zaten hesabınız var mı? <a asp-action="Giris">Giriş yapın</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
