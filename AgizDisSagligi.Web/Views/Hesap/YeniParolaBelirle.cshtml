@model AgizDisSagligi.Web.Models.YeniParolaViewModel
@{
    ViewData["Title"] = "Yeni Parola Belirle";
}

<h1>Yeni Parola Belirle</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="YeniParolaBelirle" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Mail" type="hidden" />

            <div class="mb-3">
                <label class="form-label">Yeni Parola</label>
                <input asp-for="YeniParola" type="password" class="form-control" />
                <span asp-validation-for="YeniParola" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni Parola Tekrar</label>
                <input asp-for="YeniParolaTekrar" type="password" class="form-control" />
                <span asp-validation-for="YeniParolaTekrar" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Parolayı Güncelle</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
