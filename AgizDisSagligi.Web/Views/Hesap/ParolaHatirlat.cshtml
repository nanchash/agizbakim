@model AgizDisSagligi.Web.Models.ParolaHatirlatViewModel
@{
    ViewData["Title"] = "Parola Hatırlatma";
}

<div class="auth-sarmalayici">
    <div class="auth-kart">
        <div class="auth-simge">🔑</div>
        <h1>Parolamı Unuttum</h1>
        <p class="auth-alt-metin">Kayıtlı mail adresinizi girin, yeni parola belirleyelim.</p>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger">@ViewBag.Hata</div>
        }

        <form asp-action="ParolaHatirlatDogrula" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label class="form-label">Mail</label>
                <input asp-for="Mail" type="email" class="form-control" placeholder="ornek@mail.com" />
                <span asp-validation-for="Mail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Devam Et</button>
        </form>

        <p class="auth-alt-metin mt-3 mb-0">
            <a asp-action="Giris">Girişe geri dön</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
