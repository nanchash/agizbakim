@{
    ViewData["Title"] = "Parola Hatırlatma";
}

<div class="auth-sarmalayici">
    <div class="auth-kart">
        <div class="auth-simge">🔑</div>
        <h1>Parolamı Unuttum</h1>
        <p class="auth-alt-metin">Kayıtlı mail adresinize gönderilecek doğrulama koduyla yeni parola belirleyin.</p>

        <div id="mesajAlani"></div>

        <div id="mailAlani">
            <div class="mb-4">
                <label class="form-label">Mail</label>
                <input id="mailInput" type="email" class="form-control" placeholder="ornek@mail.com" required />
            </div>
            <button type="button" id="dogrulaBtn" class="btn btn-primary w-100">Doğrulama Kodu Gönder</button>
        </div>

        <div id="kodAlani" class="d-none">
            <div class="mb-4">
                <label class="form-label">Doğrulama Kodu <span class="form-text">(mail adresinize gönderildi)</span></label>
                <input id="kodInput" type="text" inputmode="numeric" maxlength="6" class="form-control" placeholder="6 haneli kod" required />
            </div>
            <button type="button" id="kodDogrulaBtn" class="btn btn-primary w-100">Kodu Doğrula</button>
        </div>

        <div id="parolaAlanlari" class="d-none">
            <div class="mb-3">
                <label class="form-label">Yeni Parola</label>
                <input id="yeniParolaInput" type="password" class="form-control" required />
                <div class="form-text">Büyük-küçük harf ve rakam içermelidir.</div>
            </div>
            <div class="mb-4">
                <label class="form-label">Yeni Parola Tekrar</label>
                <input id="yeniParolaTekrarInput" type="password" class="form-control" required />
            </div>
            <button type="button" id="guncelleBtn" class="btn btn-primary w-100">Parolayı Güncelle</button>
        </div>

        <p class="auth-alt-metin mt-3 mb-0">
            <a asp-action="Giris">Girişe geri dön</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        var dogrulanmisMail = null;
        var dogrulanmisKod = null;

        function mesajGoster(basarili, mesaj) {
            var sinif = basarili ? 'alert-success' : 'alert-danger';
            $('#mesajAlani').html('<div class="alert ' + sinif + ' mb-3">' + mesaj + '</div>');
        }

        $('#dogrulaBtn').on('click', function () {
            var mail = $('#mailInput').val();
            if (!mail) {
                mesajGoster(false, 'Mail adresi zorunludur.');
                return;
            }

            $('#dogrulaBtn').prop('disabled', true);
            $.ajax({
                url: '@Url.Action("ParolaHatirlatDogrula", "Hesap")',
                type: 'POST',
                data: { Mail: mail },
                success: function (sonuc) {
                    $('#dogrulaBtn').prop('disabled', false);
                    if (sonuc.basarili) {
                        dogrulanmisMail = mail;
                        mesajGoster(true, sonuc.mesaj);
                        $('#mailAlani').addClass('d-none');
                        $('#kodAlani').removeClass('d-none');
                    } else {
                        mesajGoster(false, sonuc.mesaj);
                    }
                },
                error: function () {
                    $('#dogrulaBtn').prop('disabled', false);
                    mesajGoster(false, 'Bir şeyler ters gitti. Lütfen tekrar deneyin.');
                }
            });
        });

        $('#kodDogrulaBtn').on('click', function () {
            var kod = $('#kodInput').val();
            if (!kod) {
                mesajGoster(false, 'Doğrulama kodu zorunludur.');
                return;
            }

            $('#kodDogrulaBtn').prop('disabled', true);
            $.ajax({
                url: '@Url.Action("ParolaSifirlamaKoduDogrula", "Hesap")',
                type: 'POST',
                data: { mail: dogrulanmisMail, kod: kod },
                success: function (sonuc) {
                    $('#kodDogrulaBtn').prop('disabled', false);
                    if (sonuc.basarili) {
                        dogrulanmisKod = kod;
                        $('#mesajAlani').empty();
                        $('#kodAlani').addClass('d-none');
                        $('#parolaAlanlari').removeClass('d-none');
                    } else {
                        mesajGoster(false, sonuc.mesaj);
                    }
                },
                error: function () {
                    $('#kodDogrulaBtn').prop('disabled', false);
                    mesajGoster(false, 'Bir şeyler ters gitti. Lütfen tekrar deneyin.');
                }
            });
        });

        $('#guncelleBtn').on('click', function () {
            var yeniParola = $('#yeniParolaInput').val();
            var yeniParolaTekrar = $('#yeniParolaTekrarInput').val();
            if (!yeniParola || !yeniParolaTekrar) {
                mesajGoster(false, 'Yeni parola ve tekrarı zorunludur.');
                return;
            }

            $('#guncelleBtn').prop('disabled', true);
            $.ajax({
                url: '@Url.Action("YeniParolaBelirle", "Hesap")',
                type: 'POST',
                data: { Mail: dogrulanmisMail, Kod: dogrulanmisKod, YeniParola: yeniParola, YeniParolaTekrar: yeniParolaTekrar },
                success: function (sonuc) {
                    $('#guncelleBtn').prop('disabled', false);
                    if (sonuc.basarili) {
                        mesajGoster(true, sonuc.mesaj + ' Girişe yönlendiriliyorsunuz…');
                        $('#parolaAlanlari').addClass('d-none');
                        setTimeout(function () {
                            window.location.href = '@Url.Action("Giris", "Hesap")';
                        }, 1500);
                    } else {
                        mesajGoster(false, sonuc.mesaj);
                    }
                },
                error: function () {
                    $('#guncelleBtn').prop('disabled', false);
                    mesajGoster(false, 'Bir şeyler ters gitti. Lütfen tekrar deneyin.');
                }
            });
        });
    </script>
}
